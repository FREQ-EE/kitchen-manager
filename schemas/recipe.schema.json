{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kitchen Manager recipe",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "status",
    "ingredients",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Open vocabulary; currently experiment, tested, perfected, variant."
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Collection ID, colon, stable pantry item ID"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "recipe": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "temperature_c": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "subtitle": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "yield_text": {
      "type": "string"
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "overrides"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "omit": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
