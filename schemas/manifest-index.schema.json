{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonical_branch": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pantry\\.[a-z0-9_]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^inventory/pantry/[a-z0-9-]+\\.json$"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "canonical_branch",
    "collections"
  ],
  "additionalProperties": true
}
