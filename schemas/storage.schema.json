{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "name",
          "places"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "stores"
  ],
  "additionalProperties": true
}
