{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "favourite": {
            "type": "boolean"
          }
        },
        "required": [
          "rating",
          "favourite"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "recipes"
  ],
  "additionalProperties": true
}
